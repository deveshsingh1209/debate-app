# Copy to .env. Everything here is optional; the defaults run a local,
# single-user server on http://127.0.0.1:8794.

# --- server ---
# PORT=8794
# HOST=127.0.0.1            # anything other than loopback REQUIRES ACCESS_PASSWORD
# ACCESS_PASSWORD=          # puts a sign-in screen in front of the app
# ALLOWED_HOSTS=            # extra host names/IPs you open the app by, comma-separated
# SESSION_TTL_HOURS=12
# DATA_DIR=./data

# --- providers (this app stores no credentials) ---
# You need one of four. Step by step: docs/CONNECT-YOUR-AI.md, or the app's
# "Connect your AI" screen. After editing a key here, press Re-check there.
# 1. Claude sign-in: uses your own Claude Code login. Run `claude` once and sign in.
# 2. Claude API key: pay per use on the same Claude models (needs Claude Code installed, not signed in).
# ANTHROPIC_API_KEY=
# 3. ChatGPT via Codex: uses your own `codex login`, read from here.
# CODEX_HOME=~/.codex
# 4. OpenAI API key: pay per use.
# OPENAI_API_KEY=

# --- the room ---
# FOUNDER_NAME=             # how the panel addresses you
# MOCK=1                    # scripted debate, no model calls

# --- notifications (optional) ---
# Browser notifications need nothing here. Telegram is off unless BOTH are set;
# setup steps are in docs/REFERENCE.md, "Notifications". Your own bot, outbound only.
# TELEGRAM_BOT_TOKEN=       # from @BotFather; never logged or shown by the app
# TELEGRAM_CHAT_ID=         # `npm run notify:chat-id` prints it
# TELEGRAM_NOTIFY=question,approval,paused,error,report
# TELEGRAM_DETAIL=minimal   # minimal: no debate text at all; title: adds the debate title
# PUBLIC_URL=               # link base in messages, e.g. the address your phone uses

# --- engine limits ---
# MAX_AGENTS=4              # agent turns running at once (one kept for research)
# No spending limit is applied by default. Depth profiles, waste guards and
# quota-pause timings live in shared/budget.ts, not here.
# BUDGET_CEILING_USD=25     # optional: ask before spending more than this per debate (off when unset; never cuts)
# The *_THINKING values below apply only to debates created before depth profiles.
# MAX_FLOOR_MESSAGES=120    # read but unused by the current engine
# TURN_THINKING=32000
# FLOOR_THINKING=24000
# REFEREE_THINKING=32000
# STEER_THINKING=8000
# HEAVY_THINKING=60000
# TURN_TIMEOUT_MIN=10
# RESEARCH_TIMEOUT_MIN=20
# QUANT_TIMEOUT_MIN=8

# --- tools (auto-detected) ---
# AGENT_CLI_PATH=           # path to the `claude` executable
# AGENT_NODE_BIN=           # node runtime dir, only for a JavaScript Claude CLI
# CHROME_PATH=              # Chrome/Chromium for PDF export; "none" turns it off
# CHROME_NO_SANDBOX=1       # only if PDF export fails: the app already falls back by itself where Chrome's sandbox cannot start
